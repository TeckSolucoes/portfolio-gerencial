# Copie para .env e preencha com valores reais. Nunca commitar o .env de verdade
# (já está no .gitignore).

# Arquivo SQLite local (mesma convenção do projeto irmão Capacity: pasta
# data/ na raiz, arquivo .db versionado fora do git). Caminho relativo à raiz
# do projeto. O diretório data/ precisa existir antes de rodar as migrations.
DATABASE_URL="file:./data/teck-portfolio.db"

# Auth.js (NextAuth) v5 — segredo para assinar sessão/JWT. Gerar com:
# openssl rand -base64 32
NEXTAUTH_SECRET=""

# URL pública onde a app roda (usada por callbacks do Auth.js).
# Dev: http://localhost:3000 — Produção: URL real do domínio no EasyPanel.
NEXTAUTH_URL="http://localhost:3000"

# reCAPTCHA v2 ("Não sou um robô") no login — gerar em
# https://www.google.com/recaptcha/admin/create (tipo "Desafio v2" > "Caixa de
# seleção 'Não sou um robô'", domínio: o do EasyPanel). Enquanto essas duas
# variáveis estiverem vazias, o captcha fica desativado (login funciona igual
# hoje) — sem isso o deploy quebraria login pra todo mundo antes de existir
# uma chave de verdade.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# Opcional: endereço do arquivo mensal de servidores SIAPE do Portal da Transparência ({AAAAMM} = mês).
# Só preencha se o Portal mudar o endereço padrão.
# PORTAL_SERVIDORES_URL="https://portaldatransparencia.gov.br/download-de-dados/servidores/{AAAAMM}_Servidores_SIAPE"

# Bases externas em modo somente leitura. Em produção, cadastrar apenas no Ambiente do EasyPanel.
FUNCAO_DB_HOST=""
FUNCAO_DB_PORT="3306"
FUNCAO_DB_USER=""
FUNCAO_DB_PASSWORD=""
FUNCAO_DB_NAME=""

# O conector qualifica o schema em cada consulta; DB_NAME não é necessário.
FRONT_V1_DB_HOST=""
FRONT_V1_DB_PORT="3306"
FRONT_V1_DB_USER=""
FRONT_V1_DB_PASS=""

# Front V2: o MySQL só é alcançado pelo túnel SSH.
FRONT_V2_DB_HOST=""
FRONT_V2_DB_PORT="3306"
FRONT_V2_DB_USER=""
FRONT_V2_DB_PASS=""
FRONT_V2_SSH_HOST=""
FRONT_V2_SSH_PORT="22"
FRONT_V2_SSH_USER=""
FRONT_V2_SSH_PRIVATE_KEY_BASE64=""
