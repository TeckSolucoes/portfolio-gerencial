# Copie para .env e preencha com valores reais. Nunca commitar o .env de verdade
# (já está no .gitignore).

# Arquivo SQLite local (mesma convenção do projeto irmão Capacity: pasta
# data/ na raiz, arquivo .db versionado fora do git). Caminho relativo à raiz
# do projeto. O diretório data/ precisa existir antes de rodar as migrations.
DATABASE_URL="file:./data/teck-portfolio.db"

# Auth.js (NextAuth) v5 — segredo para assinar sessão/JWT. Gerar com:
# openssl rand -base64 32
NEXTAUTH_SECRET=""

# URL pública onde a app roda (usada por callbacks do Auth.js).
# Dev: http://localhost:3000 — Produção: URL real do domínio no EasyPanel.
NEXTAUTH_URL="http://localhost:3000"

# Integração Jira Cloud (bloqueada até o usuário fornecer domínio/e-mail/token
# de uma conta de serviço — ver plano §5 e §"Pendências").
# Domínio do site Jira, sem protocolo, ex: "minhaempresa" (para minhaempresa.atlassian.net)
JIRA_SITE_DOMAIN=""
# E-mail da conta de serviço usada para autenticar na API do Jira
JIRA_EMAIL=""
# API token da conta de serviço (gerado em id.atlassian.com/manage-profile/security/api-tokens)
JIRA_API_TOKEN=""

# Segredo compartilhado que protege POST /api/sync/jira (header x-sync-secret),
# usado pelo Cron/Scheduled Task do EasyPanel para disparar o sync. Gerar com:
# openssl rand -hex 32
JIRA_SYNC_SECRET=""

# reCAPTCHA v2 ("Não sou um robô") no login — gerar em
# https://www.google.com/recaptcha/admin/create (tipo "Desafio v2" > "Caixa de
# seleção 'Não sou um robô'", domínio: o do EasyPanel). Enquanto essas duas
# variáveis estiverem vazias, o captcha fica desativado (login funciona igual
# hoje) — sem isso o deploy quebraria login pra todo mundo antes de existir
# uma chave de verdade.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
