// Schema do Portfólio Teck — ver plano em
// C:\Users\pflen\.claude\plans\validated-dreaming-steele.md (§1)
//
// Prisma 7: sem `url` no bloco datasource (removido nesta major — a URL de
// conexão agora vive em prisma.config.ts, e o PrismaClient em runtime recebe
// um driver adapter explícito). Generator `prisma-client` (não mais
// `prisma-client-js`) gera um client TS para src/generated/prisma.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Tone {
  violet
  ember
  teal
  rose
  sky
}

enum FrontStatus {
  ok
  attention
  blocked
  concluido
}

enum ItemStatus {
  done
  doing
  todo
  blocked
}

enum DerivationMode {
  auto
  manual
}

enum SyncStatus {
  running
  success
  error
}

enum Role {
  superadmin
  gerente
  visualizador
}

enum CustoPeriodicidade {
  unico
  mensal
  anual
}

enum CustoStatus {
  pendente
  pago
}

model Company {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  tag       String
  tone      Tone
  tagline   String
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Link público de compartilhamento (sem login) — token é a própria chave de
  // busca em /share/[token], não o slug, pra não depender de "segredo por
  // obscuridade" sobre uma URL previsível. Nulo até o superadmin gerar o
  // primeiro link. "Renovar" reaproveita o mesmo token só empurrando
  // shareExpiresAt; gerar de novo troca o token (revoga o link antigo).
  shareToken     String?   @unique @map("share_token")
  shareExpiresAt DateTime? @map("share_expires_at")

  fronts Front[]

  @@map("companies")
}

model Front {
  id        String  @id @default(uuid())
  companyId String  @map("company_id")
  slug      String
  title     String
  summaryHtml String @map("summary_html")

  statusMode   DerivationMode @default(manual) @map("status_mode")
  statusManual FrontStatus?   @map("status_manual")

  progressMode   DerivationMode @default(manual) @map("progress_mode")
  progressManual Int?           @map("progress_manual")

  ownerName     String @map("owner_name")
  ownerInitials String @map("owner_initials")

  // Quem pediu a frente (negócio) vs. ownerName, quem executa — distinção
  // real pedida pelo usuário. Default "A definir" na coluna (não só no app)
  // pra backfillar as fronts existentes sem exigir migração de dado à parte.
  requesterName String @default("A definir") @map("requester_name")

  nextMilestone String?   @map("next_milestone")
  nextDate      DateTime? @map("next_date")

  prioritized Boolean @default(false)

  jql      String?  @map("jql")
  // SQLite via Prisma não suporta colunas de array escalar nativas — armazenamos
  // como JSON serializado (String) e convertemos para string[] na borda da app
  // (ver src/app/admin/companies/[companySlug]/fronts/actions.ts).
  epicKeys String   @default("[]") @map("epic_keys")

  sortOrder  Int       @map("sort_order")
  archivedAt DateTime? @map("archived_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   FrontItem[]

  @@unique([companyId, slug])
  @@map("fronts")
}

model FrontItem {
  id           String      @id @default(uuid())
  frontId      String      @map("front_id")
  jiraIssueKey String?     @map("jira_issue_key")
  titleOverride  String?   @map("title_override")
  statusOverride ItemStatus? @map("status_override")
  note   String?
  hidden Boolean @default(false)

  sortOrder Int @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  front Front @relation(fields: [frontId], references: [id], onDelete: Cascade)

  @@unique([frontId, jiraIssueKey])
  @@map("front_items")
}

model JiraStatusMapping {
  id             String     @id @default(uuid())
  jiraStatusName String     @unique @map("jira_status_name")
  mappedStatus   ItemStatus @map("mapped_status")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  @@map("jira_status_mappings")
}

model JiraSyncSnapshot {
  id           String     @id @default(uuid())
  startedAt    DateTime   @default(now()) @map("started_at")
  finishedAt   DateTime?  @map("finished_at")
  status       SyncStatus
  errorMessage String?    @map("error_message")
  triggeredBy  String?    @map("triggered_by")

  @@map("jira_sync_snapshots")
}

model JiraIssueCache {
  id             String    @id @default(uuid())
  jiraIssueKey   String    @unique @map("jira_issue_key")
  jiraIssueType  String?   @map("jira_issue_type")
  parentEpicKey  String?   @map("parent_epic_key")
  summary        String?
  jiraStatusName String?   @map("jira_status_name")
  dueDate        DateTime? @map("due_date")
  updatedAtJira  DateTime? @map("updated_at_jira")
  rawJson        Json      @map("raw_json")
  lastSyncedAt   DateTime  @default(now()) @map("last_synced_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("jira_issue_cache")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(visualizador)
  displayName  String   @map("display_name")
  displayTitle String?  @map("display_title")

  // Empresas (códigos de src/lib/empresas.ts, separados por vírgula) que o usuário pode ver.
  // Vazio = nenhuma; superadmin ignora e vê todas. Lido do banco a cada request, não do token.
  empresas       String  @default("")
  // Gerente que só pode ver a própria turma no relatório (primeiro nome, ex.: "Luana").
  escopoGerente  String? @map("escopo_gerente")

  // Rate limit de login (força bruta) — contador zera no sucesso, bloqueia
  // por LOCK_DURATION_MINUTES (src/lib/auth.ts) ao chegar em MAX_ATTEMPTS.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  auditorias AuditoriaUsuario[]
  permissoes PermissaoUsuario[]

  @@map("users")
}

model PermissaoPerfil {
  role           Role
  funcionalidade String
  permitido      Boolean
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@id([role, funcionalidade])
  @@map("permissoes_perfil")
}

model PermissaoUsuario {
  userId         String @map("user_id")
  funcionalidade String
  permitido      Boolean
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, funcionalidade])
  @@map("permissoes_usuario")
}

model RoteiroConvenio {
  id            String   @id @default(uuid())
  nome          String   @unique
  descricao     String?
  regrasJson    String   @default("[]") @map("regras_json")
  observacoes   String?
  ativo         Boolean  @default(true)
  criadoPor     String?  @map("criado_por")
  atualizadoPor String?  @map("atualizado_por")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("roteiros_convenios")
}

model Custo {
  id                  String              @id @default(uuid())
  nome                String
  descricao           String?
  periodicidade       CustoPeriodicidade
  valorPadraoCentavos Int                 @map("valor_padrao_centavos")
  ativo               Boolean             @default(true)
  criadoPor           String?             @map("criado_por")
  atualizadoPor       String?             @map("atualizado_por")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  lancamentos CustoLancamento[]

  @@map("custos")
}

model CustoLancamento {
  id            String      @id @default(uuid())
  custoId       String      @map("custo_id")
  competencia   String
  valorCentavos Int         @map("valor_centavos")
  status        CustoStatus @default(pendente)
  pagoEm        DateTime?   @map("pago_em")
  observacao    String?
  criadoPor     String?     @map("criado_por")
  atualizadoPor String?     @map("atualizado_por")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  custo Custo @relation(fields: [custoId], references: [id], onDelete: Cascade)

  @@unique([custoId, competencia])
  @@index([competencia, status])
  @@map("custo_lancamentos")
}

// Trilha de uso do portal. A relação fica nula se o cadastro for removido,
// preservando o histórico pelo e-mail e nome gravados no momento do evento.
model AuditoriaUsuario {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  userEmail String   @map("user_email")
  userName  String   @map("user_name")
  acao      String
  rota      String?
  detalhes  String?
  latitude  Float?
  longitude Float?
  criadoEm  DateTime @default(now()) @map("criado_em")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, criadoEm])
  @@index([userEmail, criadoEm])
  @@map("auditoria_usuarios")
}

// Meta mensal por empresa, informada pelo ADM. Sem registro, o relatório mostra a meta de MODELO.
model MetaMensal {
  id          String   @id @default(uuid())
  empresa     String
  mes         String // YYYY-MM
  valor       Float
  atualizadoPor String?  @map("atualizado_por")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([empresa, mes])
  @@map("metas_mensais")
}

// Workers: tarefas agendadas (sem IA, só código) que atualizam notícias, mercado, diários e
// transparência. WorkerConfig guarda o que o ADM muda em tela; WorkerExecucao é o histórico.
model WorkerConfig {
  // id do worker no registro (src/lib/workers/registro.ts), ou "__padrao__" para a agenda padrão
  id           String   @id
  ativo        Boolean  @default(true)
  intervaloMin Int? @map("intervalo_min") // legado (agenda por intervalo); não é mais lido
  horarios     String? // "08:00,13:00,19:00" em Brasília; null = segue a agenda padrão
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("worker_configs")
}

model WorkerExecucao {
  id          String    @id @default(uuid())
  workerId    String    @map("worker_id")
  iniciadoEm  DateTime  @map("iniciado_em")
  terminadoEm DateTime? @map("terminado_em")
  status      String // rodando | ok | erro
  itens       Int?
  mensagem    String?
  origem      String // agendado | manual

  @@index([workerId, iniciadoEm])
  @@map("worker_execucoes")
}

// Disparo do relatório por WhatsApp (W-API). Linha única (id "padrao"), editada na aba WhatsApp.
// Agenda e liga/desliga ficam no WorkerConfig do worker "whatsapp-relatorio".
model WhatsappConfig {
  id            String   @id
  instanceId    String   @map("instance_id")
  token         String
  destinatarios String // um por linha: número com DDI+DDD, grupo @g.us ou @lid
  empresas      String // CSV, mesma convenção de users.empresas
  atualizadoPor String?  @map("atualizado_por")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("whatsapp_config")
}

// Mapeamento mensal de servidores (Portal da Transparência) para achar clientes novos.
// Resumo de cada mês processado do arquivo oficial.
model PortalMes {
  mes             String   @id // AAAA-MM do arquivo do Portal
  totalServidores Int      @map("total_servidores")
  entraram        Int
  jaClientes      Int      @map("ja_clientes")
  acionaveis      Int
  ignoradas       Int
  processadoEm    DateTime @default(now()) @map("processado_em")

  @@map("portal_meses")
}

// A lista do comercial: quem entrou no mês e não é nosso cliente. Tem nome de pessoa: só superadmin
// vê, e listas com mais de 12 meses são apagadas.
model PortalNovo {
  id            String @id @default(uuid())
  mes           String
  servidorId    String @map("servidor_id") // Id_SERVIDOR_PORTAL
  nome          String
  cpf6          String
  orgao         String
  orgaoSuperior String @map("orgao_superior")
  uf            String
  cargo         String
  situacao      String
  ingressoCargo String @map("ingresso_cargo")
  tipo          String // recem-nomeado | outro
  chave         String // hash de cpf6 + nome (cruza com base_clientes)

  @@unique([mes, servidorId])
  @@index([chave])
  @@map("portal_novos")
}

// Nossa base (export do Front / SELECT do Função), SEM CPF nem nome: só o hash da pessoa.
model BaseCliente {
  id     String @id @default(uuid())
  origem String // front | funcao
  chave  String
  data   String // AAAA-MM-DD ou ''
  valor  Float
  status String

  @@index([chave])
  @@index([origem])
  @@map("base_clientes")
}

model BaseImportacao {
  origem       String   @id // front | funcao
  arquivo      String
  linhas       Int
  ignoradas    Int
  importadoEm  DateTime @default(now()) @map("importado_em")
  importadoPor String?  @map("importado_por")

  @@map("base_importacoes")
}

// Empresas do grupo acompanhadas pelo módulo Jurídico. Os CNPJs são cadastrados em tela;
// os workers consultam somente estes registros, sem identificadores fixos no código.
model JuridicoEmpresa {
  id                   String   @id @default(uuid())
  cnpj                 String   @unique
  razaoSocial          String   @map("razao_social")
  nomeFantasia         String?  @map("nome_fantasia")
  situacaoCadastral    String?  @map("situacao_cadastral")
  naturezaJuridica     String?  @map("natureza_juridica")
  atividadePrincipal   String?  @map("atividade_principal")
  municipio            String?
  uf                   String?
  ativo                Boolean  @default(true)
  criadoPor            String?  @map("criado_por")
  dadosAtualizadosEm   DateTime? @map("dados_atualizados_em")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  eventos JuridicoEvento[]
  fontes  JuridicoFonteStatus[]

  @@map("juridico_empresas")
}

model JuridicoEvento {
  id            String   @id @default(uuid())
  empresaId     String   @map("empresa_id")
  fonte         String
  tipo          String
  identificador String
  titulo        String
  resumo        String?
  url           String?
  dataEvento    DateTime? @map("data_evento")
  encontradoEm  DateTime @default(now()) @map("encontrado_em")
  visto         Boolean  @default(false)

  empresa JuridicoEmpresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, fonte, identificador])
  @@index([empresaId, encontradoEm])
  @@index([visto, encontradoEm])
  @@map("juridico_eventos")
}

model JuridicoFonteStatus {
  empresaId    String   @map("empresa_id")
  fonte        String
  status       String
  mensagem     String?
  consultadoEm DateTime @default(now()) @map("consultado_em")

  empresa JuridicoEmpresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@id([empresaId, fonte])
  @@map("juridico_fontes_status")
}
